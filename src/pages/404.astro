---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';

const { name } = (await getEntry('profile', 'profile'))!.data;
---

<Base title={`Not found · ${name}`} description="This page does not exist.">
  <main class="page">
    <h1>This page does not exist.</h1>
    <p><a href="/">Back home</a></p>
  </main>
</Base>

<style>
  main {
    padding-top: 96px;
  }
  h1 {
    margin: 0 0 12px;
    font: 600 32px/1.2 var(--font-sans);
    letter-spacing: -0.015em;
  }
</style>
