---
import { getEntry } from 'astro:content';
import Hero from '../components/home/Hero.astro';
import Base from '../layouts/Base.astro';

const { name, role, description } = (await getEntry('profile', 'profile'))!.data;
---

<Base title={`${name} · ${role}`} description={description}>
  <main class="page">
    <Hero />
  </main>
</Base>
