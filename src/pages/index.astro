---
import { getEntry } from 'astro:content';
import About from '../components/home/About.astro';
import Education from '../components/home/Education.astro';
import Experience from '../components/home/Experience.astro';
import Hero from '../components/home/Hero.astro';
import Projects from '../components/home/Projects.astro';
import SectionPill from '../components/site/SectionPill.astro';
import Base from '../layouts/Base.astro';

const { name, description } = (await getEntry('profile', 'profile'))!.data;
---

<Base title={name} description={description}>
  <main class="page">
    <Hero />
    <Experience />
    <Education />
    <Projects />
    <About />
  </main>
  <SectionPill />
</Base>
