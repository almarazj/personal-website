---
import { getEntry } from 'astro:content';
import ThemeToggle from './ThemeToggle.astro';

const profile = await getEntry('profile', 'profile');
---

<header class="site-header" data-header>
  <div class="page bar">
    <a class="name" href="/">{profile?.data.name}</a>
    <button type="button" class="search" data-palette-open aria-label="Search or jump to">
      <span>Search or jump to...</span><kbd>/</kbd>
      <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-4-4"></path></svg>
    </button>
    <div class="right"><ThemeToggle /></div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    /* The glass bleeds over the body gutters to the viewport edges; .bar keeps the content on the page frame. */
    margin-inline: calc(-1 * var(--gutter-l)) calc(-1 * var(--gutter-r));
    padding-inline: var(--gutter-l) var(--gutter-r);
    background: color-mix(in srgb, var(--bg) 72%, transparent);
    -webkit-backdrop-filter: blur(14px) saturate(150%);
    backdrop-filter: blur(14px) saturate(150%);
    border-bottom: 1px solid transparent;
    transition: border-color 150ms;
  }
  .site-header[data-stuck] {
    border-bottom-color: var(--line);
  }
  @media (prefers-reduced-transparency: reduce) {
    .site-header {
      background: var(--bg);
    }
  }
  /* Name, search and toggle; the outer columns share the rest so the search stays centered. */
  .bar {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 16px;
    height: 56px;
  }
  .search {
    display: flex;
    min-width: 0;
    justify-content: space-between;
    gap: 24px;
    width: min(360px, 40vw);
    padding: 8px 12px;
    font: 400 13px/1 var(--font-mono);
    color: var(--muted);
    background: var(--soft);
    border: 1px solid var(--line);
    border-radius: var(--radius-control);
    cursor: pointer;
  }
  .search:hover {
    border-color: var(--faint);
  }
  .search kbd {
    font: inherit;
    color: var(--faint);
  }
  .icon {
    display: none;
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
  }
  .right {
    justify-self: end;
  }
  @media (max-width: 680px) {
    .bar {
      grid-template-columns: minmax(0, 1fr) auto auto;
      gap: 8px;
    }
    .search {
      width: auto;
      padding: 7px 9px;
    }
    .search span,
    .search kbd {
      display: none;
    }
    .search .icon {
      display: block;
    }
  }
  .name {
    font: 600 18px/1 var(--font-serif);
    color: var(--fg);
    text-decoration: none;
    white-space: nowrap;
  }
</style>

<script>
  // The border appears once the hero has scrolled away, or right away on pages without one. "Away" includes a jump to the
  // first section, which stops at its 72px scroll margin and leaves the hero's last pixels just below the header.
  const STUCK_AT = 120;
  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const hero = document.getElementById('hero');
  const update = () => header.toggleAttribute('data-stuck', !hero || hero.getBoundingClientRect().bottom < STUCK_AT);
  addEventListener('scroll', update, { passive: true });
  update();
</script>
