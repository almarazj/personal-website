<dialog class="palette" aria-label="Search or jump to" aria-modal="true" data-palette>
  <div class="field">
    <button type="button" class="back" aria-label="Close search" data-palette-close>
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M19 12H5M12 19l-7-7 7-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </button>
    <input
      type="text"
      role="combobox"
      aria-label="Search or jump to"
      aria-expanded="true"
      aria-controls="palette-list"
      aria-autocomplete="list"
      placeholder="Search or jump to..."
      autocomplete="off"
      spellcheck="false"
      data-palette-input
    />
    <kbd>esc</kbd>
  </div>
  <div class="chips" role="group" aria-label="Filter by group" data-palette-chips></div>
  <div id="palette-list" class="list" role="listbox" aria-label="Results" data-palette-list></div>
  <p class="status" role="status" data-palette-status></p>
  <p class="cheat" aria-hidden="true">
    <span><kbd>j</kbd> <kbd>k</kbd> next / prev section</span>
    <span><kbd>g</kbd> <kbd>e</kbd> <kbd>d</kbd> <kbd>p</kbd> <kbd>a</kbd> sections</span>
    <span><kbd>t</kbd> theme</span>
    <span><kbd>g</kbd> <kbd>g</kbd> top</span>
  </p>
</dialog>

<style is:global>
  .palette {
    width: min(640px, calc(100vw - 32px));
    max-height: min(560px, 80dvh);
    margin: 12vh auto auto;
    padding: 0;
    color: var(--fg);
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--radius-panel);
    box-shadow: 0 24px 60px rgb(0 0 0 / 0.28);
    overflow: hidden;
  }
  .palette[open] {
    display: flex;
    flex-direction: column;
  }
  /* The panel's own entrance and exit are driven by palette.ts; the backdrop only fades. */
  .palette::backdrop {
    background: rgb(20 21 24 / 0.45);
    animation: palette-fade 220ms ease-out;
  }
  .palette[data-opening] {
    opacity: 0;
  }
  .palette[data-opening]::backdrop {
    animation: none;
    opacity: 0;
  }
  .palette[data-closing] {
    pointer-events: none;
  }
  .palette[data-closing]::backdrop {
    animation: palette-fade-out 200ms ease-in forwards;
  }
  @keyframes palette-fade {
    from {
      opacity: 0;
    }
  }
  @keyframes palette-fade-out {
    to {
      opacity: 0;
    }
  }
  /* The site-wide reduced-motion rule does not reach ::backdrop. */
  @media (prefers-reduced-motion: reduce) {
    .palette::backdrop {
      animation: none !important;
    }
  }
  /* Phones only: on desktop the field already says esc. */
  .palette .back {
    display: none;
  }
  .palette .field {
    flex: none;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 16px;
    border-bottom: 1px solid var(--line);
  }
  .palette input {
    flex: 1;
    min-width: 0;
    font: 400 15px/1.2 var(--font-mono);
    color: var(--fg);
    background: none;
    border: 0;
    outline: 0;
  }
  .palette kbd {
    font: 400 11.5px/1 var(--font-mono);
    color: var(--faint);
    padding: 2px 5px;
    border: 1px solid var(--line);
    border-radius: 4px;
  }
  .palette .chips {
    display: none;
    flex: none;
    flex-wrap: nowrap;
    gap: 8px;
    padding: 10px 16px;
    overflow-x: auto;
    border-bottom: 1px solid var(--line);
  }
  .palette .chips button {
    flex: none;
    min-height: 32px;
    padding: 0 12px;
    font: 500 12.5px/1 var(--font-mono);
    color: var(--muted);
    background: var(--soft);
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    cursor: pointer;
  }
  .palette .chips button[aria-pressed='true'] {
    color: var(--bg);
    background: var(--fg);
    border-color: var(--fg);
  }
  .palette .list {
    flex: 1;
    overflow-y: auto;
    padding: 6px;
  }
  .palette .group-label {
    padding: 10px 10px 4px;
    font: 600 11px/1 var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--faint);
  }
  .palette [role='option'] {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 9px 10px;
    border-radius: var(--radius-control);
    cursor: pointer;
  }
  .palette [role='option'][aria-selected='true'] {
    background: var(--soft);
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }
  .palette .dot {
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: var(--radius-pill);
  }
  .palette .label {
    flex: none;
    max-width: 60%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 14px;
  }
  .palette .hint {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 13px;
    color: var(--muted);
  }
  .palette .keys {
    flex: none;
    display: flex;
    gap: 4px;
  }
  .palette .status {
    margin: 0;
    padding: 0 16px 12px;
    font-size: 13px;
    color: var(--muted);
  }
  .palette .status:empty {
    display: none;
  }
  .palette .cheat {
    flex: none;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    margin: 0;
    padding: 10px 16px;
    font: 400 12px/1.4 var(--font-mono);
    color: var(--faint);
    border-top: 1px solid var(--line);
  }
  @media (max-width: 680px) {
    /* Anchored to the top, so the on-screen keyboard never covers the field; it keeps to the visible height, leaving backdrop to tap away. */
    .palette {
      width: 100%;
      max-width: none;
      max-height: calc(var(--palette-room, 100dvh) - 48px);
      margin: 0 0 auto;
      border-width: 0 0 1px;
      border-radius: 0 0 var(--radius-panel) var(--radius-panel);
      padding-top: env(safe-area-inset-top);
    }
    .palette .field {
      padding-left: 6px;
      gap: 6px;
    }
    .palette .back {
      flex: none;
      display: grid;
      place-items: center;
      width: 40px;
      height: 40px;
      padding: 0;
      color: var(--muted);
      background: none;
      border: 0;
      border-radius: var(--radius-control);
      cursor: pointer;
    }
    .palette .back svg {
      width: 20px;
      height: 20px;
    }
    .palette .back:active {
      background: var(--soft);
    }
    .palette[open] .chips {
      display: flex;
    }
    .palette [role='option'] {
      min-height: 52px;
    }
    .palette .keys,
    .palette .cheat,
    .palette .field kbd {
      display: none;
    }
    .palette input {
      font-size: 16px; /* stops iOS zooming the page on focus */
    }
  }
</style>

<script>
  import { initPalette } from './palette';

  initPalette(document.querySelector<HTMLDialogElement>('[data-palette]')!);
</script>
