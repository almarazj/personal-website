---
import { getEntry } from 'astro:content';
import { commit as sha, repoUrl as repo, tag } from '../../lib/build';
import { external } from '../../lib/links';

const profile = await getEntry('profile', 'profile');
const { name, links } = profile!.data;
---

<footer class="page site-footer">
  <div class="row">
    <p>
      {`© ${new Date().getFullYear()} ${name}`}
      {links.map(({ label, url }) => <> · <a href={url} {...external(url)}>{label}</a></>)}
    </p>
    {
      sha && (
        <p class="stamp">
          {tag && <a href={`${repo}/tree/${tag}`} {...external(repo)} title="Release this page was built from">{tag}</a>}
          <a href={`${repo}/commit/${sha}`} {...external(repo)} title="Commit this page was built from">{sha.slice(0, 7)}</a>
        </p>
      )
    }
  </div>
  <div class="row hints">
    <p class="keys" aria-hidden="true"><kbd>/</kbd> search <kbd>j</kbd> <kbd>k</kbd> sections <kbd>t</kbd> theme <kbd>g</kbd> <kbd>g</kbd> top</p>
    <a href="#top">↑ back to top</a>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--section-gap);
    padding-block: 24px;
    border-top: 1px solid var(--line);
    font-size: 13px;
    color: var(--muted);
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 8px 24px;
  }
  .row + .row {
    margin-top: 8px;
  }
  p {
    margin: 0;
  }
  a {
    color: var(--muted);
  }
  a:hover {
    color: var(--fg);
  }
  .stamp {
    display: inline-flex;
    border: 1px solid var(--line);
    border-radius: var(--radius-control);
    font: 400 11.5px/1.4 var(--font-mono);
    font-variant-numeric: tabular-nums;
  }
  .stamp a {
    padding: 2px 8px;
    text-decoration: none;
  }
  .stamp a + a {
    border-left: 1px solid var(--line);
  }
  .hints {
    font: 400 12px/1.6 var(--font-mono);
    color: var(--faint);
  }
  kbd {
    font: inherit;
    padding: 0 4px;
    border: 1px solid var(--line);
    border-radius: 4px;
  }
  /* Keyboard shortcuts mean nothing on touch screens. */
  @media (hover: none) {
    .keys {
      display: none;
    }
  }
</style>
