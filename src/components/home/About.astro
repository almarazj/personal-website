---
import { getEntry, render } from 'astro:content';
import type { ANSWER_ICONS } from '../../content.config';
import { external } from '../../lib/links';
import PhotoStack from './PhotoStack.astro';

const about = (await getEntry('about', 'about'))!;
const { Content } = await render(about);
const { questions, photos } = about.data;
const signature = (await getEntry('profile', 'profile'))!.data.name.split(' ')[0];

// 24px stroke icons; the color says what kind of answer it is.
const icons: Record<(typeof ANSWER_ICONS)[number], { color: string; svg: string }> = {
  book: { color: 'var(--c-experience)', svg: '<path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/>' },
  'book-open': { color: 'var(--c-experience)', svg: '<path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>' },
  film: { color: 'var(--c-about)', svg: '<rect x="2" y="2" width="20" height="20" rx="2"/><path d="M7 2v20M17 2v20M2 12h20M2 7h5M2 17h5M17 17h5M17 7h5"/>' },
  music: { color: 'var(--c-projects)', svg: '<path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/>' },
  flag: { color: 'var(--c-experience)', svg: '<path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><path d="M4 22v-7"/>' },
  ball: { color: 'var(--c-education)', svg: '<circle cx="12" cy="12" r="10"/><path d="m12 7 4.5 3.3-1.7 5.2H9.2L7.5 10.3z"/><path d="M12 7V2M16.5 10.3l4.8-1.6M14.8 15.5l2.9 4M9.2 15.5l-2.9 4M7.5 10.3 2.7 8.7"/>' },
};
const host = (url: string) => new URL(url).hostname.replace(/^www\./, '');
---

<section id="about" class="section about" style="--sc: var(--c-about)">
  <div class="track" data-about-track>
    <div class="stage" data-about-stage>
      <h2 class="section-label">About</h2>
      <div id="about-me" class:list={['intro', { solo: photos.length === 0 }]}>
        {photos.length > 0 && <PhotoStack photos={photos} />}
        <div class="note-slot">
          <div class="bio note" data-about-note>
            <span class="tape" aria-hidden="true"></span>
            <Content />
            <p class="sign" aria-hidden="true" data-sign>
              {signature}
              <svg viewBox="0 0 92 14"><path d="M2 9 C 22 3, 46 13, 70 6 S 88 4, 90 5"></path></svg>
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>

  {
    questions.length > 0 && (
      <div id="about-questions" data-entry>
        <h3 class="sub">Quick questions</h3>
        <dl class="qa">
          {questions.map((q) => (
            <div class="row">
              <dt>{q.q}</dt>
              <dd>
                <span class="answer">
                  <svg viewBox="0 0 24 24" aria-hidden="true" style={`color: ${icons[q.icon].color}`} set:html={icons[q.icon].svg} />
                  {q.a}
                </span>
                <span class="detail">
                  {q.detail}
                  {q.link && (
                    <>
                      {' · '}
                      <a href={q.link} {...external(q.link)}>
                        {host(q.link)} ↗
                      </a>
                    </>
                  )}
                </span>
              </dd>
            </div>
          ))}
        </dl>
      </div>
    )
  }
</section>

<style>
  .intro {
    display: grid;
    grid-template-columns: 460px minmax(0, 1fr);
    gap: 48px;
    align-items: center;
  }
  .intro.solo {
    grid-template-columns: 1fr;
  }
  /* Wide screens pin the section over a scroll track that writes the note; any jump to it lands at the track's end, note written. */
  @media (min-width: 680px) and (prefers-reduced-motion: no-preference) {
    .about {
      --track: 120vh;
      scroll-margin-top: calc(-1 * var(--track));
    }
    /* Height in the content box, where a sticky child can travel; padding would not count. */
    .track::after {
      content: '';
      display: block;
      height: var(--track);
    }
    .stage {
      position: sticky;
      top: 72px;
    }
  }
  .note-slot {
    display: flex;
    justify-content: center;
    min-width: 0;
  }
  /* A sheet of graph paper taped beside the polaroids, written in black ink; it stays light in dark mode, like their frames. */
  .note {
    --lh: 34px;
    --paper: #fbfbf8;
    --grid: #d6dfe8;
    --ink: #1a1a1c;
    position: relative;
    width: 100%;
    max-width: 520px;
    padding: calc(var(--lh) * 1.5) 30px var(--lh) 34px;
    rotate: -1deg;
    color: var(--ink);
    font: 400 29px/var(--lh) var(--font-hand);
    /* The shadow follows the paper, not a box. */
    filter: drop-shadow(0 2px 5px rgb(0 0 0 / 0.13));
  }
  :global([data-mode='dark']) .note {
    --paper: #e9e8e4;
    --grid: #cbd2da;
  }
  .note::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-color: var(--paper);
    background-image: linear-gradient(var(--grid) 1px, transparent 1px), linear-gradient(90deg, var(--grid) 1px, transparent 1px);
    background-size: calc(var(--lh) / 2) calc(var(--lh) / 2);
    /* Puts a grid line under each line of text. */
    background-position: 0 calc(var(--lh) * 1.5 - 9px);
  }
  .tape {
    position: absolute;
    top: -12px;
    left: 50%;
    width: 112px;
    height: 30px;
    translate: -50% 0;
    rotate: 3deg;
    background: rgb(236 226 196 / 0.78);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.08);
  }
  .note :global(p) {
    margin: 0;
  }
  .note :global(a) {
    color: inherit;
    text-decoration: underline 1.5px;
    text-underline-offset: 3px;
  }
  .note :global(del) {
    text-decoration: line-through 2px;
    transition: text-decoration-color 260ms ease-out;
  }
  .sign {
    margin-top: calc(var(--lh) / 2) !important;
    font-size: 42px;
    text-align: right;
  }
  .sign svg {
    display: block;
    width: 92px;
    height: 14px;
    margin: -4px 0 0 auto;
    overflow: visible;
  }
  .sign path {
    fill: none;
    stroke: var(--ink);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-dasharray: 120;
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 420ms ease-out;
  }
  /* Until the writing reaches them, the lines under and through the words wait too. */
  .note[data-written] :global(a:not([data-written])) {
    text-decoration-color: transparent;
  }
  .note[data-written] :global(del:not([data-written])) {
    text-decoration-color: transparent;
  }
  .note[data-written] .sign:not([data-written]) path {
    stroke-dashoffset: 120;
  }
  :global(::highlight(unwritten)) {
    color: transparent;
  }
  .sub {
    margin: 40px 0 8px;
    font: 600 12.5px/1.4 var(--font-mono);
    color: var(--sc);
  }
  .qa {
    margin: 0;
  }
  .row {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    gap: 4px 24px;
    padding: 14px 0;
  }
  .row + .row {
    border-top: 1px solid var(--line);
  }
  .row:last-child {
    padding-bottom: 0;
  }
  dt {
    font: 400 12.5px/1.9 var(--font-mono);
    color: var(--muted);
  }
  dd {
    margin: 0;
  }
  .answer {
    display: flex;
    align-items: center;
    gap: 10px;
    font: 600 19px/1.35 var(--font-serif);
  }
  .answer svg {
    flex: none;
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .detail {
    display: block;
    margin: 2px 0 0 30px;
    font-size: 14px;
    color: var(--muted);
  }
  .detail a {
    color: var(--muted);
  }
  @media (max-width: 679px) {
    .intro {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .row {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import { initAboutNote } from './about-note';

  const note = document.querySelector<HTMLElement>('[data-about-note]');
  const track = document.querySelector<HTMLElement>('[data-about-track]');
  const stage = document.querySelector<HTMLElement>('[data-about-stage]');
  if (note && track && stage) initAboutNote(note, track, stage);
</script>
