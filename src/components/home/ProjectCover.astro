---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { projectArt } from './project-art';

interface Props {
  project: CollectionEntry<'projects'>['data'];
  /** Rendered width in CSS pixels at its largest, for the image variants. */
  width: number;
  /** Crops to the card's 16:9; the project page shows the whole image. */
  crop?: boolean;
  class?: string;
  loading?: 'lazy' | 'eager';
}
const { project: p, width, crop = true, class: className, loading = 'lazy' } = Astro.props;
const svg = p.cover?.format === 'svg';
// Uncropped, the image takes its own width (capped by the box), so its space is reserved before it loads.
const shown = p.cover && (svg ? p.cover.width : Math.min(width, p.cover.width));
const size = !crop && shown ? `width: ${shown}px` : undefined;
---

<div class:list={['cover', { crop }, className]}>
  {
    svg && p.cover ? (
      // A vector is sharp at any size, so it is served once instead of in density variants.
      <Image src={p.cover} alt={p.coverAlt!} width={p.cover.width} height={p.cover.height} style={size} loading={loading} />
    ) : p.cover ? (
      <Image src={p.cover} alt={p.coverAlt!} width={shown!} densities={[1, 2]} style={size} loading={loading} />
    ) : (
      <svg viewBox="0 0 160 90" aria-hidden="true" set:html={projectArt(p.domains[0])} />
    )
  }
</div>

<style>
  .cover {
    max-width: 100%;
    background: var(--soft);
    color: var(--c-projects);
  }
  .crop {
    aspect-ratio: 16 / 9;
  }
  /* The browser paints the alt text while the image loads; keep it out of sight (screen readers still read it). */
  img {
    color: transparent;
  }
  img,
  svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .crop img,
  .crop svg {
    height: 100%;
    object-fit: cover;
  }
  svg :global(.box) {
    fill: color-mix(in srgb, currentColor 12%, var(--bg));
    stroke: currentColor;
  }
  svg :global(.lbl) {
    fill: color-mix(in srgb, currentColor 75%, var(--fg));
    font: 500 6.4px var(--font-mono);
    text-anchor: middle;
  }
  svg :global(.ln) {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.3;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  svg :global(.dash) {
    stroke-dasharray: 4 4;
  }
  svg :global(.ax) {
    stroke: var(--line);
  }
  svg :global(.pt) {
    fill: currentColor;
  }
  svg :global(.pt2) {
    fill: color-mix(in srgb, currentColor 35%, var(--bg));
  }
</style>
